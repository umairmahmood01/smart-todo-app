# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.jks
*.keystore
keystore.properties
local.properties
#
# NOTE: app/debug.p12 is deliberately NOT ignored. It is the shared debug signing key,
# committed so every build installs over the previous one instead of forcing an uninstall
# that would wipe the database (see README, "Debug signing key"). Do not add a *.p12 rule
# here without a !app/debug.p12 negation - and never commit a release keystore.

# --- Android / Gradle ---
*.iml
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
release/
*.apk
*.aab

# --- IDE ---
.idea/
.DS_Store

# Claude Code local (personal, not shared)
.claude/settings.local.json

# --- Kotlin / Gradle build scratch (Kotlin 2.x) ---
.kotlin/
*.hprof

# CI build output pulled locally
build-output/

# --- Azure Function (azure-function/) ---
node_modules/
local.settings.json
azure-function/.func/
